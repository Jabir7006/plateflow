generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  fullName           String
  email              String              @unique
  password           String?
  role               Role
  status             UserStatus          @default(INVITED)
  createdAt          DateTime            @default(now())
  verificationTokens VerificationToken[]
  refreshTokens      RefreshToken[]
}

model MenuItem {
  id            String       @id @default(cuid())
  name          String
  price         Float
  description   String?
  imagePublicId String?
  imageUrl      String?
  isAvailable   Boolean      @default(true)
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
}

model Table {
  id     String  @id @default(cuid())
  number Int     @unique
  qrCode String  @unique
  orders Order[]
}

model MenuCategory {
  id    String     @id @default(cuid())
  name  String
  items MenuItem[]
}

model Order {
  id        String      @id @default(cuid())
  tableId   String
  table     Table       @relation(fields: [tableId], references: [id])
  status    OrderStatus @default(PENDING)
  total     Float
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model RefreshToken {
  id               String        @id @default(cuid())
  tokenHash        String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String
  expiresAt        DateTime
  sessionExpiresAt DateTime
  revokedAt        DateTime?
  revokedReason    RevokeReason?
  device           String?
  ip               String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId, expiresAt])
}

enum Role {
  MANAGER
  CHEF
  WAITER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum TokenType {
  PASSWORD_RESET
  STAFF_INVITE
}

enum RevokeReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT
  SESSION_EXPIRED
  USER_DISABLED
}
