generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  fullName           String
  email              String              @unique
  password           String?
  role               Role
  status             UserStatus          @default(INVITED)
  createdAt          DateTime            @default(now())
  verificationTokens VerificationToken[]
  refreshTokens      RefreshToken[]
}

model MenuItem {
  id            String         @id @default(cuid())
  name          String
  // Base price. Used when the item has no sizes; when it does, the chosen
  // size's price is what the diner pays.
  price         Decimal        @db.Decimal(10, 2)
  description   String?
  imagePublicId String?
  imageUrl      String?
  isAvailable   Boolean        @default(true)
  categoryId    String
  category      MenuCategory   @relation(fields: [categoryId], references: [id])
  sizes         MenuItemSize[]
  orderItems    OrderItem[]
}

model MenuItemSize {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  label      String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)

  @@index([menuItemId])
}

model Table {
  id     String  @id @default(cuid())
  number Int     @unique
  qrCode String  @unique
  orders Order[]
}

model MenuCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  items MenuItem[]
}

model Order {
  id        String      @id @default(cuid())
  tableId   String
  table     Table       @relation(fields: [tableId], references: [id])
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  note      String?
  createdAt DateTime    @default(now())
  // The status page shows "updated Xm ago" and, later, drives the live display.
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([tableId])
  // History is browsed newest-first over a date range; stats groups by status
  // over a range. These back both without a sequential scan + sort as orders
  // accumulate: [createdAt] for the unfiltered record, [status, createdAt] for
  // status-filtered history and the stats group-by.
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  // A line belongs to its order: removing the order removes its lines.
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Kept RESTRICT (the default): an item that has been ordered can't be deleted,
  // so history stays intact. The snapshots below are what the diner actually
  // ordered, frozen at order time, so the record survives later menu edits.
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  sizeLabel    String?
  quantity   Int
  // The per-unit price paid, snapshotted so a later re-price never rewrites history.
  price      Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([menuItemId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model RefreshToken {
  id               String        @id @default(cuid())
  tokenHash        String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String
  expiresAt        DateTime
  sessionExpiresAt DateTime
  revokedAt        DateTime?
  revokedReason    RevokeReason?
  device           String?
  ip               String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId, expiresAt])
}

enum Role {
  OWNER
  MANAGER
  CHEF
  WAITER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum TokenType {
  PASSWORD_RESET
  STAFF_INVITE
}

enum RevokeReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT
  SESSION_EXPIRED
  USER_DISABLED
}
