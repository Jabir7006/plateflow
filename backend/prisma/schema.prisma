generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  tables         Table[]
  orders         Order[]
}

model User {
  id                 String              @id @default(cuid())
  fullName           String
  // Login is global: an email identifies one account at one restaurant (v1).
  email              String              @unique
  password           String?
  role               Role
  status             UserStatus          @default(INVITED)
  createdAt          DateTime            @default(now())
  restaurantId       String
  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  verificationTokens VerificationToken[]
  refreshTokens      RefreshToken[]

  @@index([restaurantId])
}

model MenuItem {
  id            String         @id @default(cuid())
  name          String
  // Base price. Used when the item has no sizes; when it does, the chosen
  // size's price is what the diner pays.
  price         Decimal        @db.Decimal(10, 2)
  description   String?
  imagePublicId String?
  imageUrl      String?
  isAvailable   Boolean        @default(true)
  categoryId    String
  category      MenuCategory   @relation(fields: [categoryId], references: [id])
  restaurantId  String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  sizes         MenuItemSize[]
  orderItems    OrderItem[]

  @@index([restaurantId])
}

model MenuItemSize {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  label      String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)

  @@index([menuItemId])
}

model Table {
  id           String      @id @default(cuid())
  number       Int
  // The QR token is the only tenant anchor on the public diner path, so it must
  // resolve to one table with no prior restaurant context: globally unique.
  qrCode       String      @unique
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orders       Order[]

  // Table numbers are per-restaurant: two restaurants can both have a "Table 1".
  @@unique([restaurantId, number])
}

model MenuCategory {
  id           String      @id @default(cuid())
  name         String
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items        MenuItem[]

  // Category names are unique within a restaurant, not across the platform.
  @@unique([restaurantId, name])
}

model Order {
  id           String      @id @default(cuid())
  tableId      String
  table        Table       @relation(fields: [tableId], references: [id])
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime    @default(now())
  // The status page shows "updated Xm ago" and, later, drives the live display.
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([tableId])
  // Supports restaurant-scoped history and status/date filtering.
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  // A line belongs to its order: removing the order removes its lines.
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Kept RESTRICT (the default): an item that has been ordered can't be deleted,
  // so history stays intact. The snapshots below are what the diner actually
  // ordered, frozen at order time, so the record survives later menu edits.
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  sizeLabel    String?
  quantity   Int
  // The per-unit price paid, snapshotted so a later re-price never rewrites history.
  price      Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([menuItemId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model RefreshToken {
  id               String        @id @default(cuid())
  tokenHash        String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String
  expiresAt        DateTime
  sessionExpiresAt DateTime
  revokedAt        DateTime?
  revokedReason    RevokeReason?
  device           String?
  ip               String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId, expiresAt])
}

enum Role {
  OWNER
  MANAGER
  CHEF
  WAITER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum TokenType {
  PASSWORD_RESET
  STAFF_INVITE
}

enum RevokeReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT
  SESSION_EXPIRED
  USER_DISABLED
}
