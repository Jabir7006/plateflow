DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# Disposable database for `pnpm test`. The suite creates and deletes
# restaurants, so it refuses to run unless this is set explicitly — it never
# falls back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
PORT=4000
NODE_ENV=development
SEED_MANAGER_EMAIL=manager@gmail.com
SEED_MANAGER_PASSWORD=managerpassword
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_SECRET=your_access_token_secret
APP_URL=http://localhost:3000
MAIL_FROM=PlateFlow <onboarding@resend.dev>
RESEND_API_KEY=re_xxxxxxxxx
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
