DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# Disposable database for `pnpm test`. The suite creates and deletes
# restaurants, so it refuses to run unless this is set explicitly — it never
# falls back to DATABASE_URL.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
PORT=4000
NODE_ENV=development
SEED_MANAGER_EMAIL=manager@gmail.com
SEED_MANAGER_PASSWORD=managerpassword
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_SECRET=your_access_token_secret
APP_URL=http://localhost:3000
MAIL_FROM=PlateFlow <onboarding@resend.dev>
RESEND_API_KEY=re_xxxxxxxxx
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Public surface hardening -------------------------------------------------
# Number of proxy hops in front of Express. The Next.js rewrite is one, so only
# change this when a load balancer or CDN sits in front as well — otherwise
# req.ip (and therefore rate limiting) sees the proxy, not the client.
TRUST_PROXY=1

# Largest JSON/urlencoded request body accepted, e.g. 100kb, 1mb. Image uploads
# use multipart and have their own 5mb limit.
JSON_BODY_LIMIT=1mb

# Rate limiting defaults to on in production and off in development/test, so
# local work never hits a 429. Set RATE_LIMIT_ENABLED=true to exercise the
# limits locally. All windows are in milliseconds.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
