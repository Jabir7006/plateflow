# Express backend URL used for server-side API proxy rewrites (/api/v1/* -> BACKEND_URL/api/v1/*)
BACKEND_URL=http://localhost:4000

# Optional override for the client-side API base URL (defaults to same-origin proxy "/api/v1")
NEXT_PUBLIC_API_URL=/api/v1

# Backend origin the browser opens the socket.io connection to for realtime order
# updates. The socket connects directly (not through the /api/v1 rewrite), so in
# production set this to the public API origin, e.g. https://api.example.com
NEXT_PUBLIC_WS_URL=http://localhost:4000
