# Express backend URL used for server-side API proxy rewrites (/api/v1/* -> BACKEND_URL/api/v1/*)
BACKEND_URL=http://localhost:4000

# Optional override for the client-side API base URL (defaults to same-origin proxy "/api/v1")
NEXT_PUBLIC_API_URL=/api/v1

# Backend origin the browser opens the socket.io connection to for realtime order
# updates. The socket connects directly (not through the /api/v1 rewrite), so in
# production set this to the public API origin, e.g. https://api.example.com
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Cloudinary cloud name used by next/image's remotePatterns. Must match the
# backend's CLOUDINARY_CLOUD_NAME. Required for a production build.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dkzqijrkd

# Optional public demo-menu path. Override with a valid table QR route for this deployment.
# NEXT_PUBLIC_DEMO_MENU_PATH=/t/your-demo-table-token

# Self-serve restaurant signup. Build-time: change it and rebuild, then make sure
# the backend's SELF_SERVE_SIGNUP_ENABLED agrees. When false, /signup and the
# login-page link are not built and return 404.
NEXT_PUBLIC_SELF_SERVE_SIGNUP_ENABLED=false
